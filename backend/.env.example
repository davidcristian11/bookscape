DATABASE_URL=postgresql+psycopg://bookscape:bookscape_password@localhost:5432/bookscape_db
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=bookscape_chat
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173,https://<LAPTOP_IP>:5173
CORS_ORIGIN_REGEX=^https?://((localhost|127\.0\.0\.1)|(\d{1,3}\.){3}\d{1,3})(:\d+)?$
JWT_SECRET_KEY=change-this-dev-secret-before-production
JWT_ACCESS_TOKEN_MINUTES=60
SESSION_LIFETIME_DAYS=7
SESSION_INACTIVITY_MINUTES=30
PASSWORD_RESET_MINUTES=30
AUTH_EXPOSE_RESET_TOKEN=true

# Optional local HTTPS/LAN notes:
# Run Uvicorn with --ssl-keyfile <path-to-key> --ssl-certfile <path-to-cert>
# Example cert paths if you generate them under backend/certs/:
# SSL_KEYFILE=certs/bookscape-key.pem
# SSL_CERTFILE=certs/bookscape-cert.pem
