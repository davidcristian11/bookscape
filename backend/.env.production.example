# BookScape backend production example.
# Copy values into AWS Elastic Beanstalk environment properties or a secrets manager.
# Do not commit real secrets.

DATABASE_URL=postgresql+psycopg://bookscape_user:REPLACE_WITH_PASSWORD@bookscape-rds.example.us-east-1.rds.amazonaws.com:5432/bookscape_db
MONGODB_URL=mongodb+srv://bookscape_user:REPLACE_WITH_PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bookscape_chat

# Use exact frontend origins in production. Example for Amplify's default domain:
CORS_ORIGINS=https://main.exampleid.amplifyapp.com
# Matches no normal browser origin. Replace only if you intentionally need a narrow preview-domain regex.
CORS_ORIGIN_REGEX=^$

JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_MINUTES=60
SESSION_LIFETIME_DAYS=7
SESSION_INACTIVITY_MINUTES=30
PASSWORD_RESET_MINUTES=30

# Never expose password reset tokens in production.
AUTH_EXPOSE_RESET_TOKEN=false
